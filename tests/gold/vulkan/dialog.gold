beat open: result=pending active=1 path=''
beat type: result=pending active=1 path='notes.txt'
beat press: result=pending active=1 path='notes.txt'
beat accept: result=accepted active=0 path='notes.txt'
beat save: result=pending active=1 path='draft.md'
beat erase: result=pending active=1 path='draft.'
beat grab: result=pending active=1 path='draft.'
beat dismiss: result=cancelled active=0 path='draft.'
beat reopen: result=pending active=1 path='x'
beat escape: result=cancelled active=0 path='x'
