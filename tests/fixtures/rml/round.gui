style heading color=#ffd870ff

panel sheet x=24 y=24 w=400 h=320 color=#203050e0 border=2
  label title style=heading text="Set sail" x=16 y=10
  row menu x=16 y=36 w=368 h=28 pad=8
    button go text="Go" w=72 h=24
    button stay text="Stay" w=88 h=24 color=#40282cf0
    image mark frame=icons:1,0 w=24 h=24
  column stats x=16 y=76 w=200 h=140 pad=6
    bar health w=160 h=10 fraction=0.75
    bar magic w=160 h=10 fraction=0.4 color=#4080f0ff edge=#101828ff
    label story wrap=22 w=176 h=64 text="The tide waits for no one."
  image crest frame=icons:0,1 x=240 y=80 w=48 h=48 color=#ffffffc0
  panel biased x=288 y=192 w=96 h=64 z=1 color=#c04040c0
  panel hidden x=0 y=0 w=400 h=320 visible=false
panel corner anchor=southeast x=-8 y=-8 w=140 h=56 color=#605020ff
  label tag text="SE" x=12 y=10 color=#f0e0c0ff
panel centered anchor=center w=64 h=32 color=#8040a0a0
panel dock anchor=stretch x=8 y=8 w=8 h=8 color=#10203080
panel side anchor=top|bottom x=4 y=4 w=120 h=6 color=#20304090
